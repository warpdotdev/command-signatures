{
    "name": "github",
    "description": "Open a git repository in GitHub Desktop",
    "args": {
        "name": "path",
        "isOptional": true,
        "generators": {
            "template": "folders"
        }
    },
    "options": [
        {
            "name": "--help",
            "description": "Show the help page for a command",
            "args": {
                "name": "command",
                "isOptional": true,
                "suggestions": [
                    "clone",
                    "open",
                    "help"
                ]
            }
        }
    ],
    "subcommands": [
        {
            "name": "clone",
            "description": "Clone a repository",
            "args": {
                "name": "url|slug",
                "suggestions": [
                    {
                        "name": "https://github.com/"
                    },
                    {
                        "name": "https://gitlab.com/"
                    },
                    {
                        "name": "https://bitbucket.com/"
                    }
                ]
            },
            "options": [
                {
                    "name": [
                        "--branch",
                        "-b"
                    ],
                    "description": "The branch to checkout after cloning",
                    "args": {
                        "name": "branch"
                    }
                }
            ]
        },
        {
            "name": "open",
            "description": "Open a git repository in GitHub Desktop",
            "args": {
                "name": "path",
                "isOptional": true,
                "generators": {
                    "template": "folders"
                }
            }
        },
        {
            "name": "help",
            "description": "Show the help page for a command",
            "args": {
                "name": "command",
                "isOptional": true,
                "suggestions": [
                    "clone",
                    "open",
                    "help"
                ]
            }
        }
    ]
}
