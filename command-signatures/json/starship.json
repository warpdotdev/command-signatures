{
    "name": "starship",
    "description": "The cross-shell prompt for astronauts",
    "subcommands": [
        {
            "name": "bug-report",
            "description": "Create a pre-populated GitHub issue with configuration information",
            "options": [
                {
                    "name": [
                        "-h",
                        "--help"
                    ],
                    "description": "Print help"
                }
            ]
        },
        {
            "name": "completions",
            "description": "Generate shell completions",
            "args": {
                "name": "SHELL",
                "suggestions": [
                    "bash",
                    "elvish",
                    "fish",
                    "nushell",
                    "powershell",
                    "zsh"
                ]
            },
            "options": [
                {
                    "name": [
                        "-h",
                        "--help"
                    ],
                    "description": "Print help"
                }
            ]
        },
        {
            "name": "config",
            "description": "Edit the Starship configuration",
            "args": [
                {
                    "name": "NAME",
                    "description": "Configuration key to edit",
                    "isOptional": true
                },
                {
                    "name": "VALUE",
                    "description": "Value to set for the configuration key",
                    "isOptional": true
                }
            ],
            "options": [
                {
                    "name": [
                        "-h",
                        "--help"
                    ],
                    "description": "Print help"
                }
            ]
        },
        {
            "name": "explain",
            "description": "Explain the currently displayed modules",
            "options": [
                {
                    "name": [
                        "-s",
                        "--status"
                    ],
                    "description": "Status code of the previous command",
                    "args": {
                        "name": "STATUS_CODE",
                        "description": "Signed or unsigned 32-bit integer"
                    }
                },
                {
                    "name": "--pipestatus",
                    "description": "Exit codes of commands in the previous pipeline",
                    "args": {
                        "name": "PIPESTATUS"
                    }
                },
                {
                    "name": [
                        "-w",
                        "--terminal-width"
                    ],
                    "description": "Width of the interactive terminal",
                    "args": {
                        "name": "TERMINAL_WIDTH"
                    }
                },
                {
                    "name": [
                        "-p",
                        "--path"
                    ],
                    "description": "Path to render the prompt for",
                    "args": {
                        "name": "PATH",
                        "template": "folders"
                    }
                },
                {
                    "name": [
                        "-P",
                        "--logical-path"
                    ],
                    "description": "Logical path to render the prompt for",
                    "args": {
                        "name": "LOGICAL_PATH",
                        "template": "folders"
                    }
                },
                {
                    "name": [
                        "-d",
                        "--cmd-duration"
                    ],
                    "description": "Execution duration of the previous command in milliseconds",
                    "args": {
                        "name": "CMD_DURATION"
                    }
                },
                {
                    "name": [
                        "-k",
                        "--keymap"
                    ],
                    "description": "Keymap of fish, zsh, or cmd",
                    "args": {
                        "name": "KEYMAP"
                    }
                },
                {
                    "name": [
                        "-j",
                        "--jobs"
                    ],
                    "description": "Number of currently running jobs",
                    "args": {
                        "name": "JOBS"
                    }
                },
                {
                    "name": "--shlvl",
                    "description": "Current shell nesting level",
                    "args": {
                        "name": "SHLVL"
                    }
                },
                {
                    "name": [
                        "-h",
                        "--help"
                    ],
                    "description": "Print help"
                }
            ]
        },
        {
            "name": "init",
            "description": "Print the shell function used to execute Starship",
            "args": {
                "name": "SHELL",
                "suggestions": [
                    "bash",
                    "cmd",
                    "elvish",
                    "fish",
                    "ion",
                    "nu",
                    "powershell",
                    "tcsh",
                    "xonsh",
                    "zsh"
                ]
