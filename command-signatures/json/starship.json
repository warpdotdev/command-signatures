        {
            "name": "preset",
            "description": "Print a preset configuration",
            "args": {
                "name": "NAME",
                "description": "Preset to print",
                "isOptional": true,
                "generatorName": "presets"
            },
            "options": [
                {
                    "name": [
                        "-o",
                        "--output"
                    ],
                    "description": "Write the preset to a file instead of stdout",
                    "args": {
                        "name": "OUTPUT",
                        "template": "filepaths"
                    },
                    "exclusiveOn": [
                        "--list",
                        "-l"
                    ]
                },
                {
                    "name": [
                        "-f",
                        "--force"
                    ],
                    "description": "Overwrite an existing output file",
                    "dependsOn": [
                        "--output"
                    ]
                },
                {
                    "name": [
                        "-l",
                        "--list"
                    ],
                    "description": "List all preset names",
                    "exclusiveOn": [
                        "--output",
                        "-o"
                    ]
                },
                {
                    "name": [
                        "-h",
                        "--help"
                    ],
                    "description": "Print help"
                }
            ]
        },
        {
