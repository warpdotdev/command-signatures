#!/usr/bin/env bash
# Import nested aws/* and gcloud/* completion specs from withfig/autocomplete
# into command-signatures/json/{aws,gcloud}/*.json.
#
# These assets are looked up by slash-path loadSpec values such as "aws/s3"
# and "gcloud/compute". Re-run whenever those pointers change or when
# refreshing from a newer autocomplete revision.
#
# Usage:
#   script/import_fig_nested_specs /path/to/withfig/autocomplete
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 /path/to/withfig/autocomplete" >&2
  exit 2
fi

autocomplete_root=$(cd "$1" && pwd)
repo_root=$(cd "$(dirname "$0")/.." && pwd)
esbuild_prefix=$(mktemp -d)
cleanup() {
  rm -rf "$esbuild_prefix"
}
trap cleanup EXIT

npm install --prefix "$esbuild_prefix" --silent esbuild@0.25.0
NODE_PATH="$esbuild_prefix/node_modules" node "$repo_root/script/import_fig_nested_specs.mjs" "$autocomplete_root"
