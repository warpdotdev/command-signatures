#!/usr/bin/env bash
# Import nested aws/* and gcloud/* loadSpec command specs from a pinned
# upstream TypeScript autocomplete checkout into
# command-signatures/json/autogenerated/load_spec_targets/{aws,gcloud}/*.json.
#
# Usage:
#   script/import_load_spec_targets /path/to/upstream/autocomplete
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 /path/to/upstream/autocomplete" >&2
  exit 2
fi

autocomplete_root=$(cd "$1" && pwd)
repo_root=$(cd "$(dirname "$0")/.." && pwd)
esbuild_prefix=$(mktemp -d)
cleanup() {
  rm -rf "$esbuild_prefix"
}
trap cleanup EXIT

npm install --prefix "$esbuild_prefix" --silent esbuild@0.25.0
NODE_PATH="$esbuild_prefix/node_modules" node "$repo_root/script/import_load_spec_targets.mjs" "$autocomplete_root"
